{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.prod-server.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "./dist-server",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["server", "shared"],
  "exclude": ["tests", "scripts"]
}
