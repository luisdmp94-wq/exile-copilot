# Artefactos generados: bytes idénticos en cualquier plataforma.
# El generador (scripts/build-passive-registry.ts) escribe LF; el checkout
# debe restaurar LF también en Windows para que regenerar deje git limpio.
server/data/passives/*.json text eol=lf

# Motor de Path of Building 2 (npm run data:pob) y traducción de objetos
# (npm run data:items-en): el paquete es binario; los JSON, LF como arriba.
server/data/pob/*.gz binary
server/data/pob/*.json text eol=lf

# Fuentes y recibos de evidencia de parche: sus huellas SHA-256 se calculan
# sobre los bytes; LF en cualquier plataforma para que coincidan en Render.
docs/evidence/release/**/*.md text eol=lf
docs/evidence/0.5.5/*.md text eol=lf

# docs/PLAN.md también es artefacto de evidencia (poe-ninja-economy-endpoint):
# su huella es la del texto con LF, la misma que ve Render.
docs/PLAN.md text eol=lf
# El resto de artefactos de evidencia de server/data/releaseEvidence.json.
server/data/crafting/*.json text eol=lf
docs/evidence/crafting/**/*.md text eol=lf
docs/CRAFTING_ESSENCES.md text eol=lf
docs/CRAFTING_ALLOYS.md text eol=lf
