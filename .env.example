# Backend
# Puerto del servidor standalone (npm run dev:api / npm start)
PORT=7177

# Entorno: development | production
NODE_ENV=development

# poe.ninja — solo API económica pública documentada (https://poe.ninja/docs/api)
# User-Agent descriptivo y configurable (recomendado por poe.ninja)
POE_NINJA_USER_AGENT=exile-copilot/0.1.0 (contacto: local-dev)
# TTL de la caché de precios en segundos
POE_NINJA_CACHE_TTL_SECONDS=900
# Si es "true", no se realizan llamadas de red: solo fixtures (modo offline/demo)
POE_NINJA_OFFLINE=false

# Liga y parche por defecto (liga temporal actual de PoE2 según poe.ninja)
DEFAULT_LEAGUE=Runes of Aldur
DEFAULT_PATCH=0.5.4f

# Ruta de la base de datos SQLite (node:sqlite)
DATABASE_PATH=./data/exile-copilot.db

# Adaptadores desactivados por defecto (flags de funcionalidad)
GGG_OAUTH_ENABLED=false
EXPLAINER_LLM_ENABLED=false
# Clave para el explicador LLM (opcional; NUNCA commitear valores reales)
# EXPLAINER_LLM_API_KEY=
