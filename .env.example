# Backend
# Puerto del servidor standalone (npm run dev:api / npm start)
PORT=7177
# Solo escucha en este equipo por defecto. En contenedor suele usarse 0.0.0.0.
HOST=127.0.0.1

# Entorno: development | production
NODE_ENV=development
# Actívalo únicamente cuando todas las comprobaciones públicas estén listas.
PUBLIC_DEPLOYMENT=false

# poe.ninja — solo API económica pública documentada (https://poe.ninja/docs/api)
# User-Agent descriptivo y configurable (recomendado por poe.ninja).
# Para publicar debe incluir un correo completo o una URL HTTP(S) REAL de
# contacto. localhost y dominios reservados/de ejemplo se rechazan.
POE_NINJA_USER_AGENT=exile-copilot/0.1.0 (contacto: local-dev)
# TTL de la caché de precios en segundos (0 fuerza revalidación; máximo 3600)
POE_NINJA_CACHE_TTL_SECONDS=900
# Plazo por petición externa; al vencer se usa caché antigua o fixture no verificado.
POE_NINJA_TIMEOUT_MS=8000
# Si es "true", no se realizan llamadas de red: solo fixtures (modo offline/demo)
POE_NINJA_OFFLINE=false

# Liga y parche por defecto (liga temporal actual de PoE2 según poe.ninja)
DEFAULT_LEAGUE=Runes of Aldur
DEFAULT_PATCH=0.5.4f

# Ruta de la base de datos SQLite (node:sqlite)
DATABASE_PATH=./data/exile-copilot.db

# Seguridad pública: loopback si el proxy HTTPS está en la misma máquina, o su
# IP/CIDR exacta. El valor genérico true queda bloqueado.
TRUST_PROXY=false
# Déjalo en true en Internet; false solo para smoke/local sobre HTTP.
SECURE_COOKIES=false
API_RATE_LIMIT_PER_MINUTE=300
# Escrituras y acciones POST/PATCH: se aplica además del límite general.
WRITE_RATE_LIMIT_PER_MINUTE=60
GUIDANCE_RATE_LIMIT_PER_MINUTE=30
MENTOR_RATE_LIMIT_PER_MINUTE=15
# JSON completo. 4 MiB deja margen para importar un .build de hasta 2 MiB.
REQUEST_BODY_LIMIT_BYTES=4194304

# Adaptadores desactivados por defecto (flags de funcionalidad)
GGG_OAUTH_ENABLED=false
EXPLAINER_LLM_ENABLED=false
# Clave para el explicador LLM (opcional; NUNCA commitear valores reales)
# EXPLAINER_LLM_API_KEY=

# Mentor v3 fundamentado. Desactivado = cero llamadas y cero coste.
# La IA conversa y redacta, pero solo puede fundamentarse en hechos e ids ya
# producidos por el motor; cualquier salida dudosa vuelve a las reglas.
MENTOR_AI_ENABLED=false
# Groq es el proveedor predeterminado y dispone de un nivel gratuito con límites.
# Crea la clave en console.groq.com y guárdala solo en tu .env local.
MENTOR_AI_PROVIDER=groq
# GROQ_API_KEY=
MENTOR_AI_MODEL=openai/gpt-oss-120b
MENTOR_AI_REASONING_EFFORT=low
MENTOR_AI_TIMEOUT_MS=12000
MENTOR_AI_MAX_OUTPUT_TOKENS=256

# Alternativa opcional de pago (facturación API separada de ChatGPT):
# MENTOR_AI_PROVIDER=openai
# OPENAI_API_KEY=
# MENTOR_AI_MODEL=gpt-5.4-mini
